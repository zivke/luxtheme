{
  // `task.allowAutomaticTasks` is set to "on" in .devcontainer/devcontainer.json
  // so the folderOpen task below runs without a prompt. Drop its "runOptions"
  // to make it manual.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "claude: resume session",
      "detail": "Resume the last Claude Code session for this folder, or start a new one",
      "type": "shell",
      "command": "claude --continue || claude",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "build",
      "detail": "make build",
      "type": "shell",
      "command": "make build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "test",
      "detail": "make test (plain JVM, no device needed)",
      "type": "shell",
      "command": "make test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "install + run",
      "detail": "make run (device must be connected: make connect)",
      "type": "shell",
      "command": "make run",
      "problemMatcher": []
    }
  ]
}
